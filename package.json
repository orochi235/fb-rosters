{
  "name": "fb-rosters",
  "version": "1.1.1",
  "description": "Sample names from the 1994 Fighting Baseball rosters, plus a companion roster of early-90s celebrities built the same way",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "names.js",
    "names.json",
    "names.txt",
    "names-celebrities.js",
    "names-celebrities.json",
    "names-celebrities.txt"
  ],
  "keywords": [
    "names",
    "baseball",
    "test-data",
    "fixtures",
    "mock-data",
    "seed-data"
  ],
  "scripts": {
    "build:data": "node scripts/build-data.js",
    "prepublishOnly": "npm run build:data && npm test",
    "test": "node --test"
  },
  "author": "orochi235",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi235/fb-rosters.git"
  },
  "license": "ISC",
  "sideEffects": false
}
